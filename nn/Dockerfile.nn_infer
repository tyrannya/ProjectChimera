# HISTORICAL - not on the demo path.
#
# Disconnected at S3 by PR-13 (section 3.3). This image is not built by any
# automatically-triggered CI job and is not part of the default compose stack;
# the `nn_infer` service that uses it is behind the `legacy` profile.
# Inference service. Build from the repository root:
#   docker build -f nn/Dockerfile.nn_infer -t chimera-nn-infer .
# R1-n: digest-pinned. `python:3.11-slim` is a movable tag -- it is rebuilt on
# every upstream patch release, so two builds of this file a week apart are two
# different images with the same Dockerfile. The digest below is the manifest
# list for the 3.11-slim tag as pinned, so it resolves on every architecture.
# To bump: read the new digest and change the tag comment in the same commit,
#   docker buildx imagetools inspect python:3.11-slim | head -2
FROM python:3.11-slim@sha256:bab1b7ef4b450c81002278d035eff85ebe394ae94df904f7a3ba14f7e16e487b

# curl is needed by the compose healthcheck.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first for layer caching. The CPU wheel index keeps the image
# from pulling ~2GB of CUDA libraries that a dry-run inference service never uses.
COPY pyproject.toml ./
COPY chimera/ ./chimera/
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -e ".[ml]"

COPY nn/ ./nn/

RUN useradd --create-home --uid 10001 chimera \
    && mkdir -p /app/artifacts \
    && chown -R chimera:chimera /app
USER chimera

ENV PYTHONPATH=/app \
    CHIMERA_MODELS_DIR=/app/artifacts/models

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:3000/livez || exit 1

CMD ["uvicorn", "nn.infer_service:app", "--host", "0.0.0.0", "--port", "3000"]
