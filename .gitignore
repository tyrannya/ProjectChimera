# Secrets and runtime configuration
.env
user_data/*
!user_data/.gitkeep

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
build/
dist/

# Virtual environments
venv/
env/
ENV/
.venv/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Data and model artifacts: reproducible from the pipeline, too large for git
# Keep all runtime data ignored except the explicitly frozen research-only
# snapshots below. Those snapshots contain no Styx rows.
data/*
!data/research/
data/research/*
!data/research/btc_usdt_1h_gen1_raw_pre_styx.parquet
!data/research/btc_usdt_1h_gen1_ohlcv14_outer_coverage.parquet
!data/research/btc_usdt_1h_gen1_ohlcv14_outer_coverage.parquet.meta.json
!data/research/btc_usdt_1h_gen1_snapshot_manifest.json
# The P4-HOLD ledger: which checkpoint, if any, has spent the one pre-Styx
# region nothing has scored. It is a state file rather than data, and the
# guard in nn/p4_holdout.py has nothing to read without it.
!data/research/p4_holdout_ledger.json
# P4's stage-1 fit interlock: whether anyone has authorised this checkpoint to
# begin fitting, under whose name and for what reason. A state file rather than
# data, and the point of it is that flipping it is a *commit* — an ignored file
# would make it a local edit nobody reviews, which is the whole thing it exists
# to prevent. nn/p4_stage1.py has nothing to read without it, and a missing
# interlock is refused rather than treated as an open one.
!data/research/p4_stage1_authorisation.json

artifacts/*
# ...except the artifact index and per-directory status markers. Which research
# generation is authoritative is documentation, not output: a reader who cannot
# tell a superseded aggregate from the current one has no way to recover it from
# the ignored files themselves. Committed run artifacts predate this rule and
# are tracked individually.
!artifacts/README.md
!artifacts/diagnostics/
!artifacts/walkforward/
!artifacts/benchmark/
artifacts/diagnostics/*
artifacts/walkforward/*
artifacts/benchmark/*
!artifacts/diagnostics/*/
!artifacts/walkforward/*/
!artifacts/benchmark/*/
artifacts/diagnostics/*/*
artifacts/walkforward/*/*
artifacts/benchmark/*/*
!artifacts/diagnostics/*/STATUS.md
!artifacts/walkforward/*/STATUS.md
!artifacts/benchmark/*/STATUS.md
mlruns/
!mlruns/.gitkeep
ray_results/

# Databases
*.sqlite
*.db

# Frozen P5 primary evidence and its decision record. P5 needs no new data
# source: its 4h and 1d bars are cut from the OHLCV snapshot already allow-listed
# above, so only the artifacts are named here.
!artifacts/btc_p5_SHA256SUMS.txt
!artifacts/btc_p5_decision_SHA256SUMS.txt
!artifacts/benchmark/btc_p5_ohlcv14_lightgbm/*
!artifacts/benchmark/btc_p5_ohlcv14_logistic_regression/*
!artifacts/benchmark/btc_p5_ohlcv14_xgboost/*
!artifacts/benchmark/btc_p5_mtf_v1_lightgbm/*
!artifacts/benchmark/btc_p5_mtf_v1_logistic_regression/*
!artifacts/benchmark/btc_p5_mtf_v1_xgboost/*
!artifacts/benchmark/btc_p5_ohlcv14_plus_mtf_v1_lightgbm/*
!artifacts/benchmark/btc_p5_ohlcv14_plus_mtf_v1_logistic_regression/*
!artifacts/benchmark/btc_p5_ohlcv14_plus_mtf_v1_xgboost/*
!artifacts/benchmark/btc_p5_comparison/*
!artifacts/benchmark/btc_p5_decision/*

# Futures Execution v1 operational evidence. Not research evidence: it is the
# report of a frozen engineering protocol (`tools/futures_dry_run.py`), and
# `make check` re-verifies it against the protocol hash in the build reading it.
# Committed because the whole mechanism is that the report and the protocol are
# the same object and a checksum says so — an ignored report could not be checked.
!artifacts/futures_dry_run_v1/
!artifacts/futures_dry_run_v1/*

# Frozen P3 trade source and primary evidence.
!data/research/btc_usdt_1h_gen1_trade_snapshot_manifest.json
!data/research/btc_usdt_1h_gen1_trades_hourly_pre_styx.parquet
!artifacts/btc_p3_SHA256SUMS.txt
!artifacts/benchmark/btc_p3_microstructure_v1_lightgbm/*
!artifacts/benchmark/btc_p3_microstructure_v1_logistic_regression/*
!artifacts/benchmark/btc_p3_microstructure_v1_xgboost/*
!artifacts/benchmark/btc_p3_ohlcv14_lightgbm/*
!artifacts/benchmark/btc_p3_ohlcv14_logistic_regression/*
!artifacts/benchmark/btc_p3_ohlcv14_xgboost/*
!artifacts/benchmark/btc_p3_ohlcv14_plus_microstructure_v1_lightgbm/*
!artifacts/benchmark/btc_p3_ohlcv14_plus_microstructure_v1_logistic_regression/*
!artifacts/benchmark/btc_p3_ohlcv14_plus_microstructure_v1_xgboost/*
