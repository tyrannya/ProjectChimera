# Secrets and runtime configuration
.env
user_data/*
!user_data/.gitkeep

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
build/
dist/

# Virtual environments
venv/
env/
ENV/
.venv/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Data and model artifacts: reproducible from the pipeline, too large for git
data/
artifacts/*
# ...except the artifact index and per-directory status markers. Which research
# generation is authoritative is documentation, not output: a reader who cannot
# tell a superseded aggregate from the current one has no way to recover it from
# the ignored files themselves. Committed run artifacts predate this rule and
# are tracked individually.
!artifacts/README.md
!artifacts/diagnostics/
!artifacts/walkforward/
!artifacts/benchmark/
artifacts/diagnostics/*
artifacts/walkforward/*
artifacts/benchmark/*
!artifacts/diagnostics/*/
!artifacts/walkforward/*/
!artifacts/benchmark/*/
artifacts/diagnostics/*/*
artifacts/walkforward/*/*
artifacts/benchmark/*/*
!artifacts/diagnostics/*/STATUS.md
!artifacts/walkforward/*/STATUS.md
!artifacts/benchmark/*/STATUS.md
mlruns/
!mlruns/.gitkeep
ray_results/

# Databases
*.sqlite
*.db
