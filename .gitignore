# Secrets and runtime configuration
.env
user_data/*
!user_data/.gitkeep

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
build/
dist/

# Virtual environments
venv/
env/
ENV/
.venv/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Data and model artifacts: reproducible from the pipeline, too large for git
# Keep all runtime data ignored except the explicitly frozen research-only
# snapshots below. Those snapshots contain no Styx rows.
data/*
!data/research/
data/research/*
!data/research/btc_usdt_1h_gen1_raw_pre_styx.parquet
!data/research/btc_usdt_1h_gen1_ohlcv14_outer_coverage.parquet
!data/research/btc_usdt_1h_gen1_ohlcv14_outer_coverage.parquet.meta.json
!data/research/btc_usdt_1h_gen1_snapshot_manifest.json

artifacts/*
# ...except the artifact index and per-directory status markers. Which research
# generation is authoritative is documentation, not output: a reader who cannot
# tell a superseded aggregate from the current one has no way to recover it from
# the ignored files themselves. Committed run artifacts predate this rule and
# are tracked individually.
!artifacts/README.md
!artifacts/diagnostics/
!artifacts/walkforward/
!artifacts/benchmark/
artifacts/diagnostics/*
artifacts/walkforward/*
artifacts/benchmark/*
!artifacts/diagnostics/*/
!artifacts/walkforward/*/
!artifacts/benchmark/*/
artifacts/diagnostics/*/*
artifacts/walkforward/*/*
artifacts/benchmark/*/*
!artifacts/diagnostics/*/STATUS.md
!artifacts/walkforward/*/STATUS.md
!artifacts/benchmark/*/STATUS.md
mlruns/
!mlruns/.gitkeep
ray_results/

# Databases
*.sqlite
*.db

# Frozen P3 trade source and primary evidence.
!data/research/btc_usdt_1h_gen1_trade_snapshot_manifest.json
!data/research/btc_usdt_1h_gen1_trades_hourly_pre_styx.parquet
!artifacts/btc_p3_SHA256SUMS.txt
!artifacts/benchmark/btc_p3_microstructure_v1_lightgbm/*
!artifacts/benchmark/btc_p3_microstructure_v1_logistic_regression/*
!artifacts/benchmark/btc_p3_microstructure_v1_xgboost/*
!artifacts/benchmark/btc_p3_ohlcv14_lightgbm/*
!artifacts/benchmark/btc_p3_ohlcv14_logistic_regression/*
!artifacts/benchmark/btc_p3_ohlcv14_xgboost/*
!artifacts/benchmark/btc_p3_ohlcv14_plus_microstructure_v1_lightgbm/*
!artifacts/benchmark/btc_p3_ohlcv14_plus_microstructure_v1_logistic_regression/*
!artifacts/benchmark/btc_p3_ohlcv14_plus_microstructure_v1_xgboost/*
!artifacts/benchmark/btc_p3_comparison/*
