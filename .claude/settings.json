{
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Bash(git commit *--amend*)",
      "Bash(git rebase)",
      "Bash(git rebase *)",
      "Bash(git pull *--rebase*)",
      "Bash(git pull -r *)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--delete*)",
      "Bash(git push -d *)",
      "Bash(git push *--prune*)",
      "Bash(git push * +*)",
      "Bash(git reset *--hard*)",
      "Bash(git clean -*f*)",
      "Bash(git clean *--force*)",
      "Bash(git branch -D *)",
      "Bash(git branch -f *)",
      "Bash(git branch *--force*)",
      "Bash(git worktree remove *--force*)",
      "Bash(git worktree remove -f *)",
      "Bash(git checkout -B *)",
      "Bash(git switch -C *)",
      "Bash(git switch *--force-create*)",
      "Bash(git tag -f *)",
      "Bash(git tag *--force*)",
      "Bash(git update-ref *)",
      "Bash(git replace *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git reflog expire *)",
      "Bash(git reflog delete *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(gh auth token*)",
      "PowerShell(git commit *--amend*)",
      "PowerShell(git rebase)",
      "PowerShell(git rebase *)",
      "PowerShell(git pull *--rebase*)",
      "PowerShell(git pull -r *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git push *--mirror*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git push -d *)",
      "PowerShell(git push *--prune*)",
      "PowerShell(git push * +*)",
      "PowerShell(git reset *--hard*)",
      "PowerShell(git clean -*f*)",
      "PowerShell(git clean *--force*)",
      "PowerShell(git branch -f *)",
      "PowerShell(git branch *--force*)",
      "PowerShell(git worktree remove *--force*)",
      "PowerShell(git worktree remove -f *)",
      "PowerShell(git switch *--force-create*)",
      "PowerShell(git tag -f *)",
      "PowerShell(git tag *--force*)",
      "PowerShell(git update-ref *)",
      "PowerShell(git replace *)",
      "PowerShell(git filter-branch *)",
      "PowerShell(git filter-repo *)",
      "PowerShell(git reflog expire *)",
      "PowerShell(git reflog delete *)",
      "PowerShell(printenv)",
      "PowerShell(printenv *)",
      "PowerShell(gh auth token*)",
      "Read(//**/.env)",
      "Edit(//**/.env)",
      "Read(//**/.env.[a-df-zA-DF-Z0-9._~@+-]*)",
      "Edit(//**/.env.[a-df-zA-DF-Z0-9._~@+-]*)",
      "Read(//**/.env.e)",
      "Edit(//**/.env.e)",
      "Read(//**/.env.e[a-wyzA-WYZ0-9._~@+-]*)",
      "Edit(//**/.env.e[a-wyzA-WYZ0-9._~@+-]*)",
      "Read(//**/.env.ex)",
      "Edit(//**/.env.ex)",
      "Read(//**/.env.ex[b-zB-Z0-9._~@+-]*)",
      "Edit(//**/.env.ex[b-zB-Z0-9._~@+-]*)",
      "Read(//**/.env.exa)",
      "Edit(//**/.env.exa)",
      "Read(//**/.env.exa[a-ln-zA-LN-Z0-9._~@+-]*)",
      "Edit(//**/.env.exa[a-ln-zA-LN-Z0-9._~@+-]*)",
      "Read(//**/.env.exam)",
      "Edit(//**/.env.exam)",
      "Read(//**/.env.exam[a-oq-zA-OQ-Z0-9._~@+-]*)",
      "Edit(//**/.env.exam[a-oq-zA-OQ-Z0-9._~@+-]*)",
      "Read(//**/.env.examp)",
      "Edit(//**/.env.examp)",
      "Read(//**/.env.examp[a-km-zA-KM-Z0-9._~@+-]*)",
      "Edit(//**/.env.examp[a-km-zA-KM-Z0-9._~@+-]*)",
      "Read(//**/.env.exampl)",
      "Edit(//**/.env.exampl)",
      "Read(//**/.env.exampl[a-df-zA-DF-Z0-9._~@+-]*)",
      "Edit(//**/.env.exampl[a-df-zA-DF-Z0-9._~@+-]*)",
      "Read(//**/.env.example?*)",
      "Edit(//**/.env.example?*)",
      "Read(//**/*.pem)",
      "Edit(//**/*.pem)",
      "Read(//**/*.key)",
      "Edit(//**/*.key)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.npmrc)",
      "Edit(~/.npmrc)",
      "Read(~/.pypirc)",
      "Edit(~/.pypirc)",
      "Read(~/.git-credentials)",
      "Edit(~/.git-credentials)",
      "Edit(//**/.git)",
      "Edit(//**/.git/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Read|Write|Edit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/chimera-guardrails.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
