# Copy to .env and fill in only what you need. .env is git-ignored and must
# never be committed. Every value here is intentionally empty.
#
# Nothing in this file enables live trading. See ENABLE_LIVE_TRADING at the
# bottom for the only switch that does.

# --- exchange credentials -------------------------------------------------
# Dry-run does not place orders and works without any of these.
BINANCE_KEY=
BINANCE_SECRET=
BINANCE_TEST_KEY=
BINANCE_TEST_SECRET=

BYBIT_KEY=
BYBIT_SECRET=
BYBIT_TEST_KEY=
BYBIT_TEST_SECRET=

OKX_KEY=
OKX_SECRET=
OKX_TEST_KEY=
OKX_TEST_SECRET=

# --- optional notifications ------------------------------------------------
# Leave empty to disable Telegram entirely. The bot runs normally without it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- optional services -----------------------------------------------------
# MLflow tracking. Defaults to the local ./mlruns directory when unset.
MLFLOW_TRACKING_URI=

# Override which model the inference service loads. Normally unset, so the
# service serves whatever artifacts/models/current.json points at.
CHIMERA_MODELS_DIR=
CHIMERA_MODEL_DIR=

# --- LIVE TRADING ----------------------------------------------------------
# Leave this EMPTY unless you intend to trade real money.
#
# Live trading requires BOTH of the following, and neither alone is enough:
#   1. this variable set to exactly: I_UNDERSTAND_THE_RISK
#   2. a config with "dry_run": false (conf/<exchange>.live.json)
#
# Having exchange API keys above does NOT enable live trading.
ENABLE_LIVE_TRADING=
