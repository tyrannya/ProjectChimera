{
  "uid": "chimera-demo",
  "title": "Chimera / Demo campaign",
  "tags": [
    "chimera",
    "demo"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Runner state and heartbeat",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "chimera_demo_state",
          "legendFormat": "{{state}}",
          "refId": "A"
        },
        {
          "expr": "time() - chimera_demo_heartbeat_timestamp",
          "legendFormat": "heartbeat age",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Recorder stream ages",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "chimera_recorder_last_event_age_seconds",
          "legendFormat": "{{stream}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Equity and net PnL",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "chimera_demo_equity",
          "legendFormat": "equity",
          "refId": "A"
        },
        {
          "expr": "chimera_demo_net_pnl",
          "legendFormat": "net pnl",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Hedge state and imbalance",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "chimera_demo_hedge_state",
          "legendFormat": "{{state}}",
          "refId": "A"
        },
        {
          "expr": "chimera_demo_hedge_imbalance_btc",
          "legendFormat": "imbalance (BTC)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "Funding paid and received",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "chimera_demo_funding_total",
          "legendFormat": "{{direction}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Fees and slippage (both legs combined)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "chimera_futures_trading_fees_total",
          "legendFormat": "fees",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, sum(rate(chimera_futures_slippage_bps_bucket[1h])) by (le))",
          "legendFormat": "p90 slippage (bps)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "Vetoes by reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(chimera_futures_risk_vetoes_total[1h])) by (reason)",
          "legendFormat": "aegis {{reason}}",
          "refId": "A"
        },
        {
          "expr": "sum(increase(chimera_rejected_entries_total[1h])) by (reason)",
          "legendFormat": "runner {{reason}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Reconciliation outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(chimera_futures_reconciliation_total[1h])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    }
  ]
}
