# Supervision for the prospective recorder (PR-05, master plan section 4).
#
# Reads public Binance market data and writes it under the storage root the
# committed gen3 contract resolves. There are no credentials here, and there is
# nothing to add: the recorder has no authenticated endpoint, so an
# EnvironmentFile carrying a key would be a key this unit has no use for.
#
# Install:
#   sudo cp deploy/systemd/chimera-recorder.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now chimera-recorder
#
# Adjust User, WorkingDirectory and the two paths in ExecStart to the host. The
# defaults assume a checkout at /opt/chimera readable by the service users and
# writable by neither, with a virtualenv at /opt/chimera/.venv.
#
# R1-n SEPARATE IDENTITY. The recorder and the runner used to share one
# `chimera` user, which meant the runner could rewrite the recorder's parquet
# files and the recorder could rewrite the runner's ledger -- a pair of
# capabilities neither needs and that no amount of care in the code can take
# away. They are now two users with two writable roots:
#
#   chimera-recorder  writes /var/lib/chimera/data        (market data)
#   chimera-runner    writes /var/lib/chimera-demo        (decisions, state)
#
# The runner must still READ the recorder's output, so the data lands with
# group `chimera-data` and the runner holds that group as a supplementary one.
# Read, not write: group membership gives it no more, and ProtectSystem=strict
# in the runner's unit leaves the path read-only on top of that.
#
# Host setup, once:
#   sudo groupadd --system chimera-data
#   sudo useradd --system --gid chimera-data --no-create-home \
#       --shell /usr/sbin/nologin chimera-recorder
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin chimera-runner
#   sudo usermod --append --groups chimera-data chimera-runner
#   sudo install -d -o chimera-recorder -g chimera-data -m 2750 /var/lib/chimera/data
# The setgid bit (2750) is what keeps every later directory in the tree in
# `chimera-data` without the recorder having to set a group itself.

[Unit]
Description=Chimera prospective market-data recorder (public data, no credentials)
Documentation=file:/opt/chimera/docs/proposed_demo_implementation_master_plan.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chimera-recorder
Group=chimera-data
WorkingDirectory=/opt/chimera
# 0027: files 0640, directories 0750. The runner reads through the group; no
# other account on the host sees market data it has no business reading.
UMask=0027

# --base-dir is the directory the contract's storage root is resolved under, so
# the data lands in <base-dir>/prospective/gen3/. Keep it on a filesystem with
# room for roughly 1.5 GB of compressed raw and 0.3 GB of normalized data per
# month at these streams (section 14).
ExecStart=/opt/chimera/.venv/bin/python -m tools.recorder \
    --base-dir /var/lib/chimera/data \
    --log-level INFO \
    run --metrics-port 9102

# SIGTERM is what the service's own stop path listens for: it sets the stop
# event, the tasks wind down, the open day is normalized and a last heartbeat is
# written. Give that room to finish before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=120

# Restart on any exit, including the non-zero one the recorder uses to say it
# had write errors — a recorder that is down records nothing, and the counters
# and the heartbeat are what an operator alerts on.
Restart=always
RestartSec=10s
# Do not give up after repeated restarts: a recorder in a crash loop must keep
# trying, and StartLimitIntervalSec=0 is what stops systemd from disabling it.
StartLimitIntervalSec=0

# The recorder needs the network, its checkout and one data directory. Nothing
# else, so nothing else is reachable.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/chimera/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=chimera-recorder

[Install]
WantedBy=multi-user.target
