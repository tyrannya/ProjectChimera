# Supervision for the demo campaign runner (PR-12, master plan section 11).
#
# Reads the recorder's files, decides through the dry-run venue, and writes its
# decision log and state under the checkout. There are no credentials here and
# nothing to add: chimera/demo and chimera/carry construct venues in one place
# and both legs are DryRunFuturesVenue, so an EnvironmentFile carrying an
# exchange key would be a key this unit has no use for. There is no live route.
#
# Install:
#   sudo cp deploy/systemd/chimera-demo.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now chimera-demo
#
# Adjust User, WorkingDirectory and the paths in ExecStart to the host. The
# defaults assume a checkout at /opt/chimera owned by a `chimera` service user
# with a virtualenv at /opt/chimera/.venv, and a recorder writing to
# /var/lib/chimera/data as deploy/systemd/chimera-recorder.service does.
#
# A LONG-RUNNING SERVICE (R1-d). `tools.demo_run run` starts the runner once and
# then stays up: it catches up every closed minute, waits for the next minute
# close plus the configured READY grace (`ready_grace_seconds`, 5 s), and repeats
# until it is told to stop. systemd is therefore NOT the scheduler any more --
# before R1-d it was, through `Restart=always` + `RestartSec=30s` around a
# process that did one bounded pass and exited 0. What follows from the change:
#
#   * `systemctl status` shows the unit active for as long as the campaign runs;
#   * the metrics endpoint on 9103 lives as long as the process, so
#     `up{job="demo"}` and chimera_demo_heartbeat_timestamp (beaten at least
#     every 30 s, including while waiting) are liveness, and RunnerDown in
#     conf/alerts_demo.yml is a liveness alert;
#   * `tools.demo_run flatten/resume/resolve` refuse while this unit runs (they
#     would be a second writer on the same state directory): stop it first.
#
# The process exits in exactly three ways, and each is handled below: 0 after a
# SIGTERM/SIGINT (a stop), 3 on HALT (never restarted), and non-zero on anything
# unexpected (restarted after RestartSec, a bounded number of times).

[Unit]
# [Unit] directives, not [Service] ones: systemd has read them from [Unit] since
# v229 and logs "Unknown key name" for them anywhere else. The limit used to be
# 0 (off), because a bounded pass every thirty seconds tripped any limit within
# minutes. A service restarts only when it FAILED, so the limit is back: five
# failures in thirty minutes leaves the unit `failed` rather than restarting a
# crash loop for ever, and RunnerDown says so.
StartLimitIntervalSec=30min
StartLimitBurst=5
Description=Chimera demo runner (dry-run venue, no credentials, no live route)
Documentation=file:/opt/chimera/docs/demo_runbook.md
# The runner reads what the recorder has already written, so it is useless
# before the recorder and harmless after it. Wants, not Requires: a recorder
# that is down leaves the runner with nothing new to read, which it reports as
# INCOMPLETE_STATE rather than as a reason to stop existing.
After=network-online.target chimera-recorder.service
Wants=network-online.target chimera-recorder.service

[Service]
Type=simple
User=chimera
Group=chimera
WorkingDirectory=/opt/chimera

# --root is the recorder's storage root, read only. The runner's own state
# directory comes from the campaign configuration, whose default "state/demo" is
# relative and therefore resolves under WorkingDirectory.
#
# prometheus_client.start_http_server binds 9103 on ALL interfaces and there is
# no bind-address argument to narrow it, so the host must firewall the port to
# the Prometheus host. The same is true of the recorder's 9102.
ExecStart=/opt/chimera/.venv/bin/python -m tools.demo_run \
    --config /opt/chimera/conf/demo/pvc1.json \
    --root /var/lib/chimera/data \
    run --metrics-port 9103

# SIGTERM is what a clean stop looks like, and it is DEFERRED past persistence:
# the handler only records the request, the minute in hand runs to completion
# (its ledger, DECISION record and runner state all written), and the process
# then writes SHUTDOWN and exits 0 -- during the wait between minutes, within a
# second. 120 s is the ceiling on "the minute in hand", not a normal stop time;
# past it systemd sends SIGKILL, which section 9.3's triage recovers on the next
# start.
KillSignal=SIGTERM
TimeoutStopSec=120

# Restart=on-failure: exit 0 is a requested stop and is left stopped; an
# unexpected failure is restarted after RestartSec. RestartPreventExitStatus=3
# is the important half: tools/demo_run.py exits 3 when the runner halts (at
# start or during a pass), and a supervisor that restarted a halted campaign
# would be performing an automatic resume with no operator note -- exactly what
# DemoRunner.resume refuses to be. Leaving HALT stays a human action:
#   python -m tools.demo_run --config ... --root ... resume --note "..."
# followed by `systemctl start chimera-demo`.
Restart=on-failure
RestartSec=30s
RestartPreventExitStatus=3

# The runner needs its checkout, its own state directory and read access to the
# recorder's data. Nothing else, so nothing else is reachable. ProtectSystem=
# strict leaves /var/lib/chimera/data read-only, which is the correct posture:
# the recorder writes it and the runner only reads it.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
# Prefixed with `-`: a path that does not exist yet is skipped rather than
# failing the mount namespace. Without it the unit dies 226/NAMESPACE on a
# fresh checkout, because the state directory is created by the first run
# and ProtectSystem=strict forbids the runner from creating it.
ReadWritePaths=-/opt/chimera/state
# StateDirectory is what actually CREATES it. `ReadWritePaths=-` tolerates the
# directory being absent, which stops the unit dying 226/NAMESPACE on a fresh
# host, but tolerating an absent directory is not the same as having one: the
# runner would then fail on its first write instead, which is a worse place to
# discover it. systemd creates /var/lib/chimera-demo before the process starts,
# owned by User=, and the ExecStart paths above may point at it or at the
# operator's own /opt/chimera/state once they have created that themselves.
StateDirectory=chimera-demo

StandardOutput=journal
StandardError=journal
SyslogIdentifier=chimera-demo

[Install]
WantedBy=multi-user.target
